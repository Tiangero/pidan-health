<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.PidanHealth" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- 开屏页（core-splashscreen，API 26+ 兼容，31+ 走系统 SplashScreen）：
         橙色底 + 圆形品牌图标，退出后切回正式主题 -->
    <style name="Theme.PidanHealth.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">400</item>
        <item name="postSplashScreenTheme">@style/Theme.PidanHealth</item>
    </style>
</resources>
